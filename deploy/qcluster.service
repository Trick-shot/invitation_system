[Unit]
Description=Invitation platform background worker (django-q)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/invitations
EnvironmentFile=/srv/invitations/.env
ExecStart=/srv/invitations/.venv/bin/python manage.py qcluster
Restart=always

[Install]
WantedBy=multi-user.target
